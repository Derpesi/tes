{
  "name": "damarindo-hris",
  "private": true,
  "description": "DAMARINDO GROUP HRIS (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "pnpm --filter @hris/api dev",
    "dev:web": "pnpm --filter @hris/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
    "db:migrate": "pnpm --filter @hris/api db:migrate",
    "db:rollback": "pnpm --filter @hris/api db:rollback",
    "export:openapi": "pnpm --filter @hris/api export:openapi",
    "test:scripts": "node --test scripts/lisensi.test.mjs scripts/repo-guard.test.mjs",
    "check:licenses": "node scripts/lisensi.mjs",
    "test:isolation": "pnpm --filter @hris/tests test:integration",
    "test:rbac": "pnpm --filter @hris/tests test",
    "bootstrap": "pnpm --filter @hris/api bootstrap",
    "test:e2e": "node tests/e2e/smoke-staff.mjs",
    "seed:perusahaan": "pnpm --filter @hris/api seed:perusahaan",
    "load:seed": "node tests/load/seed-besar.mjs",
    "load:run": "node tests/load/runner.mjs",
    "ops:backup": "node scripts/ops/backup.mjs",
    "ops:restore": "node scripts/ops/restore.mjs",
    "ops:verifikasi": "node scripts/ops/verifikasi-restore.mjs",
    "ops:rotasi": "node apps/api/dist/cli/rotasi-kunci.js",
    "ops:impor-templat-pkwt": "node apps/api/dist/cli/impor-templat-pkwt.js"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "node-pg-migrate>glob": "^14.0.2"
    }
  }
}
