# CONTOH variabel produksi. Isi nilai SENDIRI di server; JANGAN commit berkas hasil isian. Tanpa nilai bawaan untuk rahasia.
NODE_ENV=production
PORT=3001
# Pengguna basis data aplikasi: bukan superuser, tanpa BYPASSRLS.
DATABASE_URL=
# Pengguna pemilik skema, hanya untuk langkah migrasi (dipakai compose "migrasi").
MIGRATE_DATABASE_URL=
DB_POOL_MAX=10
# https wajib di produksi. Tanpa garis miring di akhir.
APP_BASE_URL=
# Jumlah proxy tepercaya di depan API (nginx contoh = 1; web Next menambah 1 hop jika lalu lintas melewatinya: sesuaikan).
TRUST_PROXY=2
# Kunci acak: openssl rand -base64 32 (masing-masing BERBEDA). Cadangkan APP_ENCRYPTION_KEY TERPISAH dari data.
AUTH_HMAC_KEY=
APP_ENCRYPTION_KEY=
# Rotasi kunci (opsional): "1:<base64 kunci lama>,2:<base64 kunci baru>"; id tertinggi = aktif. Lihat docs/ops/rotasi-kunci.md.
APP_ENCRYPTION_KEYS=
# Hanya untuk alat rotasi: role BYPASSRLS khusus (bukan DATABASE_URL aplikasi).
ROTASI_DATABASE_URL=
# Volume privat penyimpanan objek (selfie/dokumen terenkripsi).
STORAGE_DIR=/var/lib/hris/objek
# Selfie absensi ditiadakan sementara (bawaan off). on = wajib selfie; tinjau retensi/PDP sebelum mengaktifkan.
ABSENSI_SELFIE=off
# Dokumentasi API mati di produksi kecuali diaktifkan eksplisit.
API_DOCS=off
# Login member (Google OIDC); lihat docs/google-oauth-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email (invitasi/reset staf). Isi semua atau kosongkan semua.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Gambar
API_IMAGE=
WEB_IMAGE=
TLS_DIR=
