{
  "name": "@hris/tests",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint \"**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js --testPathPatterns 'helpers/.*\\.spec\\.ts$|rbac-matrix/.*\\.spec\\.ts$'",
    "test:integration": "jest --config jest.config.js --runInBand --testPathPatterns '(tenant-isolation|auth|master-data|member|contract)/.*\\.spec\\.ts$'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "pg": "^8.23.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
