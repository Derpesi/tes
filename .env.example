# Salin ke .env lalu isi sendiri. JANGAN commit .env. Tidak ada nilai default untuk rahasia.
PORT=3001
DATABASE_URL=
TEST_DATABASE_URL=
# Hanya untuk docker-compose dev
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=hris_dev
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Autentikasi (Fase 3). Bangkitkan sendiri: openssl rand -base64 32
APP_BASE_URL=
AUTH_HMAC_KEY=
APP_ENCRYPTION_KEY=
# Opsional (isi semua atau kosongkan semua)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Jumlah proxy tepercaya di depan API (0 = tidak ada)
TRUST_PROXY=
# Prefiks jalur publik API (bawaan /api). Redirect URI Google = APP_BASE_URL + API_PUBLIC_PATH + /auth/member/google/callback
API_PUBLIC_PATH=
# Tujuan rewrite /api saat BUILD web (bawaan http://localhost:3001)
API_URL=
# Direktori penyimpanan objek privat (driver lokal; bawaan ./.penyimpanan)
# Selfie absensi: bawaan off (ditiadakan sementara). on = wajib selfie JPEG dari kamera (lihat docs/architecture/0012-*).
ABSENSI_SELFIE=off
# Rotasi kunci enkripsi (opsional): "1:<base64>,2:<base64>"; id tertinggi = aktif. Bila diisi, APP_ENCRYPTION_KEY boleh kosong atau sama dengan id 1 (docs/ops/rotasi-kunci.md).
APP_ENCRYPTION_KEYS=
STORAGE_DIR=
